import React, { useState, useEffect, useRef, useMemo, createContext, useContext } from 'react';

// useContext: create a context so any child can read the theme without passing props down manually
const ThemeContext = createContext();

function ThemeStatus() {
  const theme = useContext(ThemeContext);
  return <p>Current theme: {theme}</p>;
}

function App() {
  const [theme, setTheme] = useState('light');
  const [products, setProducts] = useState([
    { name: 'Pen', price: 10, qty: 5 },
    { name: 'Notebook', price: 40, qty: 3 },
  ]);
  const [search, setSearch] = useState('');
  const [productName, setProductName] = useState('');
  const [productPrice, setProductPrice] = useState('');
  const [productQty, setProductQty] = useState('');

  // useRef: reference to the name input, so we can refocus it after adding a product
  const inputRef = useRef(null);

  // useEffect: runs after render, whenever the products list changes
  useEffect(() => {
    document.title = `Inventory - ${products.length} products`;
  }, [products]);

  // useMemo: only recalculates when products or search actually change
  const filteredProducts = useMemo(() => {
    return products.filter((p) => p.name.toLowerCase().includes(search.toLowerCase()));
  }, [products, search]);

  const totalValue = useMemo(() => {
    return products.reduce((sum, p) => sum + p.price * p.qty, 0);
  }, [products]);

  const addProduct = () => {
    if (productName && productPrice && productQty) {
      setProducts([...products, { name: productName, price: Number(productPrice), qty: Number(productQty) }]);
      setProductName('');
      setProductPrice('');
      setProductQty('');
      inputRef.current.focus();
    }
  };

  const toggleTheme = () => {
    setTheme(theme === 'light' ? 'dark' : 'light');
  };

  const style = {
    backgroundColor: theme === 'light' ? '#ffffff' : '#333333',
    color: theme === 'light' ? '#000000' : '#ffffff',
    padding: '20px',
    minHeight: '100vh',
    fontFamily: 'Arial',
  };

  return (
    <ThemeContext.Provider value={theme}>
      <div style={style}>
        <h1>Inventory Management</h1>
        <ThemeStatus />
        <button onClick={toggleTheme}>Toggle Theme</button>

        <h3>Add Product</h3>
        <input ref={inputRef} placeholder="Name" value={productName} onChange={(e) => setProductName(e.target.value)} />
        <input placeholder="Price" value={productPrice} onChange={(e) => setProductPrice(e.target.value)} style={{ marginLeft: '5px' }} />
        <input placeholder="Quantity" value={productQty} onChange={(e) => setProductQty(e.target.value)} style={{ marginLeft: '5px' }} />
        <button onClick={addProduct} style={{ marginLeft: '5px' }}>Add</button>

        <h3>Search Product</h3>
        <input placeholder="Search..." value={search} onChange={(e) => setSearch(e.target.value)} />

        <ul>
          {filteredProducts.map((p, index) => (
            <li key={index}>{p.name} - ${p.price} x {p.qty}</li>
          ))}
        </ul>

        <h3>Total Inventory Value: ${totalValue}</h3>
      </div>
    </ThemeContext.Provider>
  );
}

export default App;


